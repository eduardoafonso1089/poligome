{
  "name": "poligome",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Eduardo Afonso",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:pages": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node --import tsx --test tests/*.test.mjs",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.mjs",
    "test:build": "npm run build && node --import tsx --test tests/*.test.mjs",
    "test:audit": "bash scripts/run-audits.sh",
    "benchmark:cog": "node --import tsx scripts/benchmark-cog.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@types/d3-contour": "^3.0.6",
    "d3-contour": "^4.0.2",
    "drizzle-orm": "0.45.2",
    "geotiff": "3.1.0-beta.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "ol": "^10.10.0",
    "polygon-clipping": "^0.15.7",
    "proj4": "2.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.55.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "poligome.com — Anotação de Imagens"
}
