# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
public/amostras/

# audit output
/interaction-audit/

# SAM runtimes and model weights are always downloaded locally, never versioned.
/.visionlabel-sam/
/VisionLabelSAM/
/.venv/
/venv/
/venvs/
/models/
/checkpoints/
/weights/
/downloads/
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.pth.part
*.pt.part
*.ckpt.part
*.safetensors.part

# Worktrees que ferramentas de edição criam dentro do repositório. Elas não são
# rastreadas, mas sem esta linha um `git add -A` levaria uma cópia inteira da
# árvore junto, e o eslint percorre os arquivos duplicados como se fossem
# código-fonte — foram 48 erros fantasma, todos em app/ duplicado, enquanto os
# mesmos arquivos de verdade ficam no teto de avisos que o CI aceita.
/.kilo/
